# Copy file này thành .env rồi điền. File .env đã bị git bỏ qua, KHÔNG commit.

# Token của đội: trên web bấm icon chìa khoá rồi copy (chuỗi dài bắt đầu bằng eyJ)
HEXUDON_TOKEN=

# Mã trận trên web: dán mã, "mã:team_id", hoặc cả URL trang trận đấu.
# Bot tự nhận biết trận tính giờ hay luyện tập.
GAME_ID=

# Tuỳ chọn
# Chỉ điền khi tự nhận biết sai: active hoặc practice
MODE=
# Server khác. Trống = https://hexudon.hairbui76.id.vn
URL=
RESPONSE_MS=5000

# Chỉ dùng cho server theo giao thức /api/v1/matches (không phải trang trên).
# Điền MATCH_ID thì phải để trống GAME_ID.
MATCH_ID=
