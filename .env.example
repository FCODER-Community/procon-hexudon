# Copy file này thành .env rồi điền. File .env đã bị git bỏ qua, KHÔNG commit.

# Token đội, dạng bot-...
HEXUDON_TOKEN=

# Mã trận: điền ĐÚNG MỘT trong hai dòng.
# Đấu BTC trực tiếp (m-1234). Bot gửi plan thật ngay.
MATCH_ID=
# Practice trên hexudon, qua bridge (game-id:team). Mặc định dry-run.
GAME_ID=

# Tuỳ chọn
# URL server. Trống = https://procon.ptit.edu.vn (MATCH_ID) hoặc https://hexudon.hairbui76.id.vn (GAME_ID)
URL=
RESPONSE_MS=5000
# Chỉ dùng với GAME_ID khi game đã qua ngày 0: vị trí ngày 0, ví dụ 3,17,42
INITIAL_AGENTS=
